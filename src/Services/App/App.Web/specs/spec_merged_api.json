  "components": {
    "schemas": {
      "AppErrorType": {
        "enum": [
          "InternalServerError",
          "ValidationError",
          "Message",
          "NotFound",
          "AccessDenied",
          "DomainError",
          "NotSupported",
          "NotImplemented"
        ],
        "type": "string"
      },
      "AppProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "errors": {
            "type": [
              "null",
              "object"
            ],
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "errorType": {
            "$ref": "#/components/schemas/AppErrorType"
          }
        },
        "description": "Extends RFC 7807 ProblemDetails with an app-specific AppErrorType? AppProblemDetails.ErrorType\r\nenum and field-level Dictionary&lt;string, string[]&gt;? AppProblemDetails.Errors dictionary (matches\r\nIDictionary&lt;string, string[]&gt; ValidationProblemDetails.Errors shape so clients can use the same parser)."
      },
      "CreateTodoListFileBody": {
        "required": [
          "name"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": [
              "null",
              "string"
            ]
          }
        },
        "description": "JSON-bound multipart part. The marker interface IJsonMultipartPart&lt;TSelf&gt;\r\ncontributes the static `BindAsync` that reads the form field of the same name as the\r\nconsuming parameter (here: `body`) and deserialises it via `System.Text.Json`."
      },
      "CreateTodoListRequest": {
        "required": [
          "name"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": [
              "null",
              "string"
            ]
          }
        },
        "description": "Request body for creating a TodoList.",
        "example": {
          "name": "some name",
          "description": "some description"
        }
      },
      "CurrentUserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Id of user",
            "format": "uuid"
          },
          "email": {
            "type": [
              "null",
              "string"
            ],
            "description": "Email of user",
            "example": "example@email.com"
          },
          "emailVerified": {
            "type": "boolean"
          },
          "phone": {
            "type": [
              "null",
              "string"
            ]
          },
          "phoneVerified": {
            "type": "boolean"
          },
          "firstName": {
            "type": [
              "null",
              "string"
            ],
            "example": "John"
          },
          "lastName": {
            "type": [
              "null",
              "string"
            ],
            "example": "Doe"
          }
        }
      },
      "DirectionType": {
        "enum": [
          "Asc",
          "Desc"
        ],
        "type": "string"
      },
      "FileContentHttpResult": {
        "type": "string",
        "format": "binary"
      },
      "GetInfoResponse": {
        "type": "object",
        "properties": {
          "buildDate": {
            "description": "UTC timestamp when the assembly was built.",
            "format": "date-time"
          },
          "version": {
            "type": [
              "null",
              "string"
            ],
            "description": "Informational assembly version."
          }
        }
      },
      "IFormFile": {
        "type": "string",
        "format": "binary"
      },
      "PaginationRequest": {
        "required": [
          "page",
          "limit"
        ],
        "type": "object",
        "properties": {
          "page": {
            "maximum": 2147483647,
            "minimum": 1,
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "Page number (1-based).",
            "format": "int32",
            "example": 1
          },
          "limit": {
            "maximum": 100,
            "minimum": 1,
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "Items per page.",
            "format": "int32",
            "example": 10
          }
        }
      },
      "PaginationResponse": {
        "required": [
          "page",
          "limit",
          "total"
        ],
        "type": "object",
        "properties": {
          "page": {
            "maximum": 2147483647,
            "minimum": 1,
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "Page number (1-based).",
            "format": "int32"
          },
          "limit": {
            "maximum": 100,
            "minimum": 1,
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "Items per page.",
            "format": "int32"
          },
          "total": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "Total count across all pages.",
            "format": "int64"
          }
        }
      },
      "RateTodoListResponse": {
        "required": [
          "rating"
        ],
        "type": "object",
        "properties": {
          "rating": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          }
        }
      },
      "SearchTodoListsRequest": {
        "type": "object",
        "properties": {
          "filter": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/TodoListSearchFilterDto"
              }
            ]
          },
          "sorting": {
            "$ref": "#/components/schemas/SortingOfTodoListFields"
          },
          "pagination": {
            "$ref": "#/components/schemas/PaginationRequest"
          }
        }
      },
      "SearchTodoListsResponse": {
        "type": "object",
        "properties": {
          "filter": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/TodoListSearchFilterDto"
              }
            ]
          },
          "sorting": {
            "$ref": "#/components/schemas/SortingOfTodoListFields"
          },
          "pagination": {
            "$ref": "#/components/schemas/PaginationResponse"
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TodoListDto"
            }
          }
        }
      },
      "SortingOfTodoListFields": {
        "type": "object",
        "properties": {
          "column": {
            "$ref": "#/components/schemas/TodoListFields"
          },
          "direction": {
            "$ref": "#/components/schemas/DirectionType"
          }
        }
      },
      "TodoListDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": [
              "null",
              "string"
            ]
          },
          "type": {
            "$ref": "#/components/schemas/TodoListType"
          },
          "createdAt": {
            "example": "2022-11-15T12:00:00.0000000Z"
          }
        }
      },
      "TodoListFields": {
        "enum": [
          "Id",
          "Name",
          "CreatedAt"
        ],
        "type": "string"
      },
      "TodoListItemBase": {
        "required": [
          "$type"
        ],
        "type": "object",
        "oneOf": [
          {
            "$ref": "#/components/schemas/TodoListItemOne"
          },
          {
            "$ref": "#/components/schemas/TodoListItemTwo"
          },
          {
            "$ref": "#/components/schemas/TodoListItemThree"
          }
        ],
        "properties": {
          "$type": {
            "enum": [
              "One",
              "Two",
              "Three"
            ],
            "type": "string"
          }
        },
        "discriminator": {
          "propertyName": "$type",
          "mapping": {
            "One": "#/components/schemas/TodoListItemOne",
            "Two": "#/components/schemas/TodoListItemTwo",
            "Three": "#/components/schemas/TodoListItemThree"
          }
        }
      },
      "TodoListItemOne": {
        "required": [
          "$type"
        ],
        "properties": {
          "$type": {
            "enum": [
              "One"
            ],
            "type": "string"
          },
          "descriptionOne": {
            "type": [
              "null",
              "string"
            ]
          },
          "subject": {
            "type": [
              "null",
              "string"
            ]
          },
          "name": {
            "type": "string"
          }
        }
      },
      "TodoListItemThree": {
        "required": [
          "$type"
        ],
        "properties": {
          "$type": {
            "enum": [
              "Three"
            ],
            "type": "string"
          },
          "descriptionThree": {
            "type": [
              "null",
              "string"
            ]
          },
          "name": {
            "type": "string"
          }
        }
      },
      "TodoListItemTwo": {
        "required": [
          "$type"
        ],
        "properties": {
          "$type": {
            "enum": [
              "Two"
