<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.5" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.5" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- Postgres-specific by design: FOR UPDATE SKIP LOCKED, jsonb operators, pg_advisory_lock.
         AddEfCoreStorage takes only a connection string and wires Npgsql internally; consumers
         don't bring their own provider. snake_case naming is applied per-property in the
         IEntityTypeConfigurations, no convention package. -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Plugins.Workflow.Abstractions\Plugins.Workflow.Abstractions.csproj" />
    <ProjectReference Include="..\Plugins.Workflow.Engine\Plugins.Workflow.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Migrations\" />
  </ItemGroup>

</Project>
