    <Project Path="Services/OAuthSample/OAuthSample.Web/OAuthSample.Web.csproj" />
  </Folder>
  <!--#endif-->
  <Folder Name="/Services/Plugins/">
    <Project Path="Services/Plugins/Plugins.AssemblyExtensions/Plugins.AssemblyExtensions.csproj" />
